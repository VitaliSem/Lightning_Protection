<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net8.0;net48</TargetFrameworks>
    </PropertyGroup>

    <!-- Settings for AUTOCAD 2024 (.NET Framework 4.8) -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="AutoCAD.NET" Version="24.3.0">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>
    <!-- Settings for AUTOCAD 2025+ (.NET 8.0) -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="AutoCAD.NET.Core" Version="25.0.0">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LP.Core\LP.Core.csproj" />
    </ItemGroup>

</Project>
