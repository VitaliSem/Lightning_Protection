<Window x:Class="LP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LP.UI.ViewModels"
        xmlns:views="clr-namespace:LP.UI.Views"
        Title="{Binding WindowTitle}"
        Icon="{DynamicResource AppIcon}"
        Width="960" Height="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LP.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LightningProtectorsPageViewModel}">
                <views:LightningProtectorsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SourceName}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="178" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageViewModel}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{Binding IconData}" Style="{StaticResource IconPath}"
                                  StrokeThickness="1.5" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Page -->
        <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
    </DockPanel>
</Window>
