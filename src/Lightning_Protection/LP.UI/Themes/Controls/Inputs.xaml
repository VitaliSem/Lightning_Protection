<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LP.UI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Bottom margin of a validated field: keeps room for the error line drawn by FieldErrorTemplate -->
    <Thickness x:Key="ValidatedFieldMargin">0,0,0,20</Thickness>

    <ControlTemplate x:Key="FieldErrorTemplate">
        <StackPanel>
            <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4">
                <AdornedElementPlaceholder x:Name="Placeholder" />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}" ToolTip="{Binding [0].ErrorContent}"
                       MaxWidth="{Binding ElementName=Placeholder, Path=ActualWidth}" HorizontalAlignment="Left"
                       FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource DangerBrush}" />
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="GroupErrorTemplate">
        <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4">
            <AdornedElementPlaceholder />
        </Border>
    </ControlTemplate>

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="1,0" Background="#8A8A8A" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="1" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                        <!-- Optional suffix (unit or axis) inside the right edge, taken from Tag -->
                        <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Underline" Property="Height" Value="2" />
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Number box with a unit or axis suffix (Tag) -->
    <Style x:Key="UnitInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="Padding" Value="6,0,26,0" />
    </Style>

    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
