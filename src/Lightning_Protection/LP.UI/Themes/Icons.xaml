<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icons: path markup in a 16×16 box, drawn with a stroke -->
    <Geometry x:Key="IconAdd">M8,3 V13 M3,8 H13</Geometry>
    <Geometry x:Key="IconEdit">M3,13 L4,10 L10.5,3.5 L12.5,5.5 L6,12 Z</Geometry>
    <Geometry x:Key="IconDelete">M4,5 H12 L11.3,13 H4.7 Z M3,5 H13 M6,5 V3 H10 V5</Geometry>
    <Geometry x:Key="IconGoTo">M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10 M6.5,8 A1.5,1.5 0 1 1 9.5,8 A1.5,1.5 0 1 1 6.5,8</Geometry>
    <Geometry x:Key="IconInfo">M2.5,8 A5.5,5.5 0 1 1 13.5,8 A5.5,5.5 0 1 1 2.5,8 M8,7 V11.5 M8,4.6 V5.6</Geometry>
    <Geometry x:Key="IconPick">M8,1.5 V5 M8,11 V14.5 M1.5,8 H5 M11,8 H14.5 M5,8 A3,3 0 1 1 11,8 A3,3 0 1 1 5,8</Geometry>

    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#F2B300" Geometry="M9,1 L3,9 H7 L6,15 L12,7 H8 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#9A6D00" Thickness="0.6" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
