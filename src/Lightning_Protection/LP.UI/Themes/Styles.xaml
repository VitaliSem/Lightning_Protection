<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette (design/lightning_protection_ui.html) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E5F0FA" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6368" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0B3D6B" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="#EAF3FB" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EBEEF2" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E0E5EB" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#DADFE5" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F6F9FC" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#DCE8F4" />

    <!-- Icons: path markup in a 16×16 box, drawn with a stroke -->
    <Geometry x:Key="IconAdd">M8,3 V13 M3,8 H13</Geometry>
    <Geometry x:Key="IconEdit">M3,13 L4,10 L10.5,3.5 L12.5,5.5 L6,12 Z</Geometry>
    <Geometry x:Key="IconDelete">M4,5 H12 L11.3,13 H4.7 Z M3,5 H13 M6,5 V3 H10 V5</Geometry>
    <Geometry x:Key="IconGoTo">M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10 M6.5,8 A1.5,1.5 0 1 1 9.5,8 A1.5,1.5 0 1 1 6.5,8</Geometry>
    <Geometry x:Key="IconInfo">M2.5,8 A5.5,5.5 0 1 1 13.5,8 A5.5,5.5 0 1 1 2.5,8 M8,7 V11.5 M8,4.6 V5.6</Geometry>

    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#F2B300" Geometry="M9,1 L3,9 H7 L6,15 L12,7 H8 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#9A6D00" Thickness="0.6" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Text -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#FDFDFD" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Bd" Property="Background" Value="#F7F7F7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small borderless icon button (grid rows) -->
    <Style x:Key="BtnGhostIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active/inactive switch: Tag carries the active status of the selected protector -->
    <Style x:Key="BtnToggleActive" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#E9E9E9" BorderBrush="#B5B5B5" BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="30" Height="16" Margin="0,0,6,0">
                                <Border x:Name="Track" CornerRadius="8" Background="White" BorderBrush="#8A8A8A" BorderThickness="1" />
                                <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#5F5F5F" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontWeight="SemiBold" Foreground="#5F5F5F"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Bd" Property="Background" Value="#FDFDFD" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F7F7F7" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DisabledBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource DisabledBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Containers -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{StaticResource InfoLightBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
    </Style>

    <!-- Sidebar navigation item -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="8" />
                        <Border x:Name="Marker" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.08" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#55606C" />
    </Style>

    <!-- Protector grid -->
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="{StaticResource StatusBarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="8,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridRow" TargetType="DataGridRow">
        <Setter Property="Height" Value="31" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#F1F1F1" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
